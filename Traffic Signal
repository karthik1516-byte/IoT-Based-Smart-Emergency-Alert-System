#include <SPI.h>
#include <LoRa.h>

#define SS 5
#define RST 14
#define DIO0 2
int signalStep = 1;
// LEDs
int Green_LED1 = 13;
int Red_LED1 = 12;
int Green_LED2 = 27;
int Red_LED2 = 26;
int Green_LED3 = 25;
int Red_LED3 = 33;
int Green_LED4 = 32;
int Red_LED4 = 15;

int IR1 = 4;
int IR2 = 21;
int IR1_result, IR2_result;

String incoming = "";

int ambulance, temperature, sw, spo2, hr;
void setup() {
  Serial.begin(115200);
  pinMode(IR1, INPUT);
  pinMode(IR2, INPUT);
  pinMode(Green_LED1, OUTPUT);
  pinMode(Red_LED1, OUTPUT);
  pinMode(Green_LED2, OUTPUT);
  pinMode(Red_LED2, OUTPUT);
  pinMode(Green_LED3, OUTPUT);
  pinMode(Red_LED3, OUTPUT);
  pinMode(Green_LED4, OUTPUT);
  pinMode(Red_LED4, OUTPUT);

  while (!Serial)
    ;

  Serial.println("LoRa Receiver");

  LoRa.setPins(SS, RST, DIO0);

  if (!LoRa.begin(433E6)) {
    Serial.println("Starting LoRa failed!");
    while (1)
      ;
  }

  digitalWrite(Green_LED1, LOW);
  digitalWrite(Red_LED1, LOW);
  digitalWrite(Green_LED2, LOW);
  digitalWrite(Red_LED2, LOW);
  digitalWrite(Green_LED3, LOW);
  digitalWrite(Red_LED3, LOW);
  digitalWrite(Green_LED4, LOW);
  digitalWrite(Red_LED4, LOW);
}

void loop() {
  int packetSize = LoRa.parsePacket();

  if (packetSize) {

    incoming = "";
    while (LoRa.available()) {
      incoming += (char)LoRa.read();
    }
    Serial.print("Received: ");
    Serial.println(incoming);
    int c1 = incoming.indexOf(',');
    int c2 = incoming.indexOf(',', c1 + 1);
    int c3 = incoming.indexOf(',', c2 + 1);
    int c4 = incoming.indexOf(',', c3 + 1);

    if (c1 > 0 && c2 > 0 && c3 > 0 && c4 > 0) {

      ambulance = incoming.substring(0, c1).toInt();
      temperature = incoming.substring(c1 + 1, c2).toInt();
      sw = incoming.substring(c2 + 1, c3).toInt();
      spo2 = incoming.substring(c3 + 1, c4).toInt();
      hr = incoming.substring(c4 + 1).toInt();
    }

    Serial.print("Ambulance: ");
    Serial.println(ambulance);
    Serial.print("Temperature: ");
    Serial.println(temperature);
    Serial.print("Switch: ");
    Serial.println(sw);
    Serial.print("SpO2: ");
    Serial.println(spo2);
    Serial.print("Heart Rate: ");
    Serial.println(hr);
    Serial.print("RSSI: ");
    Serial.println(LoRa.packetRssi());

    IR1_result = digitalRead(IR1);
    IR2_result = digitalRead(IR2);

    if (sw == 1) {
      if (IR1_result == 0) {
        while (IR1_result != 1) {
          IR1_result = digitalRead(IR1);
             Serial.print(" IR1_result: ");
    Serial.println( IR1_result);
          signal2();
        }
      }
      if (IR2_result == 0) {
        while (IR2_result != 1) {

          IR2_result = digitalRead(IR2);
             Serial.print(" IR2_result: ");
    Serial.println( IR2_result);
          signal4();
        }
      }
    }
  } else {

    switch (signalStep) {
      case 1:
        signal1();
        signalStep = 2;
        break;
      case 2:
        signal2();
        signalStep = 3;
        break;
      case 3:
        signal3();
        signalStep = 4;
        break;
      case 4:
        signal4();
        signalStep = 1;
        break;
    }
  }
}


// Signal control functions
void signal1() {
  Serial.println("Signal 1");
  digitalWrite(Green_LED1, HIGH);
  digitalWrite(Red_LED1, LOW);
  digitalWrite(Green_LED2, LOW);
  digitalWrite(Red_LED2, HIGH);
  digitalWrite(Green_LED3, LOW);
  digitalWrite(Red_LED3, HIGH);
  digitalWrite(Green_LED4, LOW);
  digitalWrite(Red_LED4, HIGH);
  delay(3000);
}

void signal2() {
  Serial.println("Signal 2");
  digitalWrite(Green_LED1, LOW);
  digitalWrite(Red_LED1, HIGH);
  digitalWrite(Green_LED2, HIGH);
  digitalWrite(Red_LED2, LOW);
  digitalWrite(Green_LED3, LOW);
  digitalWrite(Red_LED3, HIGH);
  digitalWrite(Green_LED4, LOW);
  digitalWrite(Red_LED4, HIGH);
  delay(3000);
}

void signal3() {
  Serial.println("Signal 3");
  digitalWrite(Green_LED1, LOW);
  digitalWrite(Red_LED1, HIGH);
  digitalWrite(Green_LED2, LOW);
  digitalWrite(Red_LED2, HIGH);
  digitalWrite(Green_LED3, HIGH);
  digitalWrite(Red_LED3, LOW);
  digitalWrite(Green_LED4, LOW);
  digitalWrite(Red_LED4, HIGH);
  delay(3000);
}

void signal4() {
  Serial.println("Signal 4");
  digitalWrite(Green_LED1, LOW);
  digitalWrite(Red_LED1, HIGH);
  digitalWrite(Green_LED2, LOW);
  digitalWrite(Red_LED2, HIGH);
  digitalWrite(Green_LED3, LOW);
  digitalWrite(Red_LED3, HIGH);
  digitalWrite(Green_LED4, HIGH);
  digitalWrite(Red_LED4, LOW);
  delay(3000);
}
