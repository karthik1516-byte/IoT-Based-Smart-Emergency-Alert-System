#include <WiFi.h>
#include <HTTPClient.h>
#include <BlynkSimpleEsp32.h>

char auth[] = BLYNK_AUTH_TOKEN;
char ssid[] = "OPPO A54";
char pass[] = "Sohan 1712";

#include <TinyGPS.h>
#include <HardwareSerial.h>
TinyGPS gps;
// Use UART2 (Serial2) for GPS
HardwareSerial GPS_Serial(2);

const int GPS_RX = 16;  // GPS TX → ESP32 RX (GPIO16)
const int GPS_TX = 17;  // Not used if you're only reading

float latitude, longitude;

#define X_PIN 34
#define Y_PIN 35
#define Z_PIN 32

float Xval, Yval, Zval;
float Xg, Yg, Zg;

// Calibration constants (adjust these if needed)
float zero_X = 1.65;  // Voltage at 0g for X
float zero_Y = 1.65;  // Voltage at 0g for Y
float zero_Z = 1.65;  // Voltage at 0g for Z

float sensitivity = 0.33;  // V/g (approx for 3.3V supply)
int buzzer = 15;

int motor1 = 13;
int motor2 = 12;
int motor3 = 14;
int motor4 = 27;

void setup() {
  Serial.begin(115200);
  GPS_Serial.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);
     Blynk.begin(auth, ssid, pass, "blynk.cloud", 80);
  pinMode(buzzer, OUTPUT);
  pinMode(motor1, OUTPUT);
  pinMode(motor2, OUTPUT);
  pinMode(motor3, OUTPUT);
  pinMode(motor4, OUTPUT);
  digitalWrite(buzzer, LOW);
  digitalWrite(motor1, LOW);
  digitalWrite(motor2, LOW);
  digitalWrite(motor3, LOW);
  digitalWrite(motor4, LOW);
}

void loop() {
  Blynk.run(); 
  for (unsigned long t = millis(); millis() - t < 1000;) {
    while (GPS_Serial.available()) {
      gps.encode(GPS_Serial.read());
    }
  }

  gps.f_get_position(&latitude, &longitude);

  Serial.print("Latitude: ");
  Serial.println(latitude, 6);
  Serial.print("Longitude: ");
  Serial.println(longitude, 6);


  // Read analog voltages (0 - 4095 for 3.3V ADC range)
  Xval = analogRead(X_PIN);
  Yval = analogRead(Y_PIN);
  Zval = analogRead(Z_PIN);

  // Convert ADC to voltage
  float Xvolt = (Xval / 4095.0) * 3.3;
  float Yvolt = (Yval / 4095.0) * 3.3;
  float Zvolt = (Zval / 4095.0) * 3.3;

  // Convert voltage to acceleration (g)
  Xg = (Xvolt - zero_X) / sensitivity;
  Yg = (Yvolt - zero_Y) / sensitivity;
  Zg = (Zvolt - zero_Z) / sensitivity;

  Serial.print("X: ");
  Serial.print(Xg, 2);
  Serial.print(" g  ");
  Serial.print("Y: ");
  Serial.print(Yg, 2);
  Serial.print(" g  ");
  Serial.print("Z: ");
  Serial.print(Zg, 2);
  Serial.println(" g");

  if ((Xg < -1) || (Xg > 0) || (Yg > 0) || (Yg < -1) || (Zg > -1)) {
     Blynk.logEvent("msg", "Accident detedcted, http://maps.google.com/maps?q=" + String(latitude,6) + "," + String(longitude,6));
    digitalWrite(motor1, LOW);
    digitalWrite(motor2, LOW);
    digitalWrite(motor3, LOW);
    digitalWrite(motor4, LOW);
    digitalWrite(buzzer, HIGH);
  

  } else {
    digitalWrite(buzzer, LOW);
    digitalWrite(motor1, HIGH);
    digitalWrite(motor2, LOW);
    digitalWrite(motor3, HIGH);
    digitalWrite(motor4, LOW);
  }

  delay(500);
}
